{
  "name": "weather-mcp-server",
  "version": "1.0.0",
  "description": "A small Model Context Protocol server for US weather forecasts and active alerts from the National Weather Service.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "weather-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weather",
    "national-weather-service"
  ],
  "author": "Luke Geel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukegeel101/weatherMCP.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.8.3"
  }
}
